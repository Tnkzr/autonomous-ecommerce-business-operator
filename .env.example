# Marketplace credentials. Copy to .env and fill in.
# NEVER commit the filled-in file. `operator status` shows which are missing.

# Amazon SP-API + Ads  — https://developer-docs.amazon.com/sp-api/
AMZ_LWA_CLIENT_ID=
AMZ_LWA_CLIENT_SECRET=
AMZ_REFRESH_TOKEN=
AMZ_SELLER_ID=
AMZ_MARKETPLACE_ID=

# Shopify Admin GraphQL — https://shopify.dev/docs/api/admin-graphql
SHOPIFY_STORE_DOMAIN=
SHOPIFY_ADMIN_ACCESS_TOKEN=

# Walmart Marketplace — https://developer.walmart.com/
WALMART_CLIENT_ID=
WALMART_CLIENT_SECRET=

# eBay Sell APIs — https://developer.ebay.com/
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
EBAY_REFRESH_TOKEN=

# TikTok Shop Partner API — https://partner.tiktokshop.com/
TIKTOK_APP_KEY=
TIKTOK_APP_SECRET=
TIKTOK_SHOP_ACCESS_TOKEN=
TIKTOK_SHOP_ID=
