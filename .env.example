# Marketplace credentials. Copy to .env and fill in.
# NEVER commit the filled-in file. `operator status` shows which are missing.

# Amazon SP-API — https://developer-docs.amazon.com/sp-api/
# From Seller Central > Apps & Services > Develop Apps.
# AMZ_MARKETPLACE_ID must be the country you sell in; US is ATVPDKIKX0DER.
# Getting it wrong authenticates fine and returns empty data, which reads as
# "no sales" rather than a misconfiguration — `amazon-verify` catches that.
AMZ_LWA_CLIENT_ID=
AMZ_LWA_CLIENT_SECRET=
AMZ_REFRESH_TOKEN=
AMZ_SELLER_ID=
AMZ_MARKETPLACE_ID=ATVPDKIKX0DER
# Optional: route to Amazon's sandbox (canned responses, no live account).
AMZ_SANDBOX=

# Amazon Ads is a SEPARATE application from SP-API — different host, scopes,
# and a profileId. SP-API credentials cannot read advertising data.
# AMZ_ADS_CLIENT_ID=
# AMZ_ADS_CLIENT_SECRET=
# AMZ_ADS_REFRESH_TOKEN=
# AMZ_ADS_PROFILE_ID=

# Shopify Admin GraphQL — https://shopify.dev/docs/api/admin-graphql
# This is the destination for TikTok traffic and the only marketplace here that
# needs no eligibility review: a custom app in your own store issues the token.
#   1. Shopify admin > Settings > Apps and sales channels > Develop apps.
#   2. "Allow custom app development" (once per store), then "Create an app".
#   3. Configuration > Admin API integration > select these scopes:
#        read_products, write_products, read_inventory, write_inventory,
#        read_orders, read_customers, read_price_rules, write_price_rules,
#        read_publications, write_publications, read_locations
#   4. Install app, then reveal the Admin API access token ONCE. It starts
#      "shpat_" and is shown a single time.
# Scopes are fixed at install: adding one later requires reinstalling the app.
# `shopify-verify` checks the token AND the scopes, because a missing scope
# fails at the point of use — typically mid-publish.
SHOPIFY_SHOP_DOMAIN=
SHOPIFY_ADMIN_ACCESS_TOKEN=
# Optional. Pinned in code to a supported version; override only deliberately,
# after reading the changelog. Shopify removes a version after ~12 months.
# SHOPIFY_API_VERSION=
# Optional: read credentials from a JSON file instead of the environment.
# SHOPIFY_CREDENTIAL_FILE=

# Walmart Marketplace — https://developer.walmart.com/
WALMART_CLIENT_ID=
WALMART_CLIENT_SECRET=

# eBay Sell APIs — https://developer.ebay.com/  *** PRIMARY MARKETPLACE ***
# The developer programme is free and open — no eligibility review, unlike
# TikTok Shop. From developer.ebay.com > Application Keys:
#   App ID (Client ID)  -> EBAY_CLIENT_ID
#   Cert ID (Client Secret) -> EBAY_CLIENT_SECRET
# Then 'User Tokens' > 'Get a Token from eBay via Your Application', run the
# consent flow as your SELLING account, and exchange the code for a refresh
# token.
# Take the PRODUCTION keyset unless you mean to test — a sandbox key against a
# production host authenticates fine and returns nothing, which reads as
# "no sales" rather than as a wrong environment.
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
EBAY_REFRESH_TOKEN=
# The site you sell on. Wrong value returns another country's listings and
# prices, silently corrupting every competitor comparison built on them.
EBAY_MARKETPLACE_ID=EBAY_US
# production | sandbox
EBAY_ENVIRONMENT=production
# The date you ran the consent flow (YYYY-MM-DD). eBay refresh tokens stop
# working about 18 months later and CANNOT be renewed in software — a human has
# to repeat the browser flow. Without this date the operator cannot warn you
# before it lapses.
EBAY_REFRESH_TOKEN_GRANTED_AT=

# TikTok Shop Partner API — https://partner.tiktokshop.com/
# From TikTok Shop Partner Center after the app is approved and authorised.
# TIKTOK_SHOP_ID must be one this app is authorised for; `tiktok-verify` lists
# the authorised shops if it is wrong. shop_cipher is NOT configured here — the
# connector fetches it from /authorization/202309/shops at startup.
TIKTOK_APP_KEY=
TIKTOK_APP_SECRET=
TIKTOK_REFRESH_TOKEN=
TIKTOK_SHOP_ID=
# Region sets currency and settlement lag; a wrong value silently corrupts
# every profit calculation. US, GB, ID, MY, TH, VN, PH, SG, JP, DE, FR, IT,
# ES, IE, MX, BR.
TIKTOK_REGION=US
TIKTOK_SANDBOX=

# NOTE: TikTok rotates the refresh token on every refresh. If you run this
# unattended, persist the rotated value — the connector warns when it rotates
# one it cannot save, and a lost rotation strands the integration months later.

# TikTok ads live in the Marketing API (business-api.tiktok.com), a separate
# application with its own credentials and advertiser_id.
# TIKTOK_ADS_APP_ID=
# TIKTOK_ADS_SECRET=
# TIKTOK_ADS_ACCESS_TOKEN=
# TIKTOK_ADS_ADVERTISER_ID=

# Optional: read TikTok credentials from a JSON file rather than the
# environment. Preferred in production, because TikTok rotates the refresh
# token on every refresh and a file can be written back — an environment
# variable cannot. Without write-back the integration keeps working until the
# old token expires, then fails weeks later with no deploy to correlate against.
# TIKTOK_CREDENTIAL_FILE=
