# Marketplace credentials. Copy to .env and fill in.
# NEVER commit the filled-in file. `operator status` shows which are missing.

# Amazon SP-API — https://developer-docs.amazon.com/sp-api/
# From Seller Central > Apps & Services > Develop Apps.
# AMZ_MARKETPLACE_ID must be the country you sell in; US is ATVPDKIKX0DER.
# Getting it wrong authenticates fine and returns empty data, which reads as
# "no sales" rather than a misconfiguration — `amazon-verify` catches that.
AMZ_LWA_CLIENT_ID=
AMZ_LWA_CLIENT_SECRET=
AMZ_REFRESH_TOKEN=
AMZ_SELLER_ID=
AMZ_MARKETPLACE_ID=ATVPDKIKX0DER
# Optional: route to Amazon's sandbox (canned responses, no live account).
AMZ_SANDBOX=

# Amazon Ads is a SEPARATE application from SP-API — different host, scopes,
# and a profileId. SP-API credentials cannot read advertising data.
# AMZ_ADS_CLIENT_ID=
# AMZ_ADS_CLIENT_SECRET=
# AMZ_ADS_REFRESH_TOKEN=
# AMZ_ADS_PROFILE_ID=

# Shopify Admin GraphQL — https://shopify.dev/docs/api/admin-graphql
SHOPIFY_STORE_DOMAIN=
SHOPIFY_ADMIN_ACCESS_TOKEN=

# Walmart Marketplace — https://developer.walmart.com/
WALMART_CLIENT_ID=
WALMART_CLIENT_SECRET=

# eBay Sell APIs — https://developer.ebay.com/
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
EBAY_REFRESH_TOKEN=

# TikTok Shop Partner API — https://partner.tiktokshop.com/
# From TikTok Shop Partner Center after the app is approved and authorised.
# TIKTOK_SHOP_ID must be one this app is authorised for; `tiktok-verify` lists
# the authorised shops if it is wrong. shop_cipher is NOT configured here — the
# connector fetches it from /authorization/202309/shops at startup.
TIKTOK_APP_KEY=
TIKTOK_APP_SECRET=
TIKTOK_REFRESH_TOKEN=
TIKTOK_SHOP_ID=
# Region sets currency and settlement lag; a wrong value silently corrupts
# every profit calculation. US, GB, ID, MY, TH, VN, PH, SG, JP, DE, FR, IT,
# ES, IE, MX, BR.
TIKTOK_REGION=US
TIKTOK_SANDBOX=

# NOTE: TikTok rotates the refresh token on every refresh. If you run this
# unattended, persist the rotated value — the connector warns when it rotates
# one it cannot save, and a lost rotation strands the integration months later.

# TikTok ads live in the Marketing API (business-api.tiktok.com), a separate
# application with its own credentials and advertiser_id.
# TIKTOK_ADS_APP_ID=
# TIKTOK_ADS_SECRET=
# TIKTOK_ADS_ACCESS_TOKEN=
# TIKTOK_ADS_ADVERTISER_ID=
