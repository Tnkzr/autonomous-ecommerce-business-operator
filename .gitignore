__pycache__/
*.py[cod]
.venv/
venv/

# Local operational state — the journal and metrics are environment-specific.
data/*.db
data/*.db-journal

# Generated reports. Regenerate with `python3 -m operator_core.cli daily`.
reports/*.md

# Never commit marketplace credentials. .env.example is the template and is
# intentionally tracked — it holds variable names only, never values.
.env
.env.*
!.env.example
*credentials*.json
